# OpenAI-compatible Refine LLM. Do not commit a real API key.
REFINE_BASE_URL=https://your-openai-compatible-endpoint.example.com/v1
REFINE_MODEL=your-refine-model
REFINE_API_KEY=replace-me

# Optional host ports.
GATEWAY_PORT=8080
QWEN3_ASR_PORT=8011
AMPHION_SPEC_PORT=9001

# Single-H20 defaults measured by this project. Tune for the target GPU.
QWEN3_ASR_GPU_MEMORY_UTILIZATION=0.15
AMPHION_SPEC_GPU_MEMORY_UTILIZATION=0.10

# Optional build acceleration.
# VLLM_IMAGE=vllm/vllm-openai:v0.18.0
# APT_DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
# APT_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security
