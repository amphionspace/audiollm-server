ARG VLLM_IMAGE=vllm/vllm-openai:v0.18.0
FROM ${VLLM_IMAGE}

USER root

# Qwen3-ASR 为语音模型：官方 vllm-openai 镜像缺音频支持
# （soundfile 需要系统库 libsndfile1；ffmpeg 供音频解码兜底）
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsndfile1 \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir "soundfile" "librosa"

USER vllm

COPY models/qwen3-asr-1.7b /models/qwen3-asr-1.7b

ENTRYPOINT ["vllm", "serve"]
CMD ["/models/qwen3-asr-1.7b", "--served-model-name", "Qwen/Qwen3-ASR-1.7B", "--host", "0.0.0.0", "--port", "8000", "--gpu-memory-utilization", "0.70", "--max-model-len", "32768"]
