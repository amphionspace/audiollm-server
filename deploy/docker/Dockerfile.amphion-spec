FROM vllm/vllm-openai:v0.18.0

COPY deploy/plugins/amphion_spec_vllm /opt/amphion-spec-vllm
RUN pip install --no-cache-dir --no-deps --no-build-isolation /opt/amphion-spec-vllm

COPY models/amphion-spec /models/amphion-spec

ENTRYPOINT ["vllm", "serve"]
CMD ["/models/amphion-spec", "--served-model-name", "AmphionSPEC", "--host", "0.0.0.0", "--port", "8000", "--trust-remote-code", "--limit-mm-per-prompt", "{\"audio\":2}", "--gpu-memory-utilization", "0.70", "--max-model-len", "16384"]
