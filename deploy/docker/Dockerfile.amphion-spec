FROM vllm/vllm-openai:v0.18.0

ARG AMPHION_ASR_REPOSITORY=https://github.com/amphionspace/AmphionASR.git
ARG AMPHION_ASR_REVISION=5525368ef2aae0d19d0dbe00cbb1c7a144712090

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && git clone "$AMPHION_ASR_REPOSITORY" /opt/AmphionASR \
    && git -C /opt/AmphionASR checkout "$AMPHION_ASR_REVISION" \
    && pip install --no-cache-dir /opt/AmphionASR/src/integrations/vllm/plugin \
    && rm -rf /var/lib/apt/lists/* /root/.cache/pip

ENTRYPOINT ["vllm", "serve"]
