# =============================================================================
# AudioLLM Server — 环境变量
# 复制本文件为 .env 后按需修改。
#
# 运行参数(ASR / VAD / 情感 / 文本清洗 / ITN 与车牌规范化等)统一在根目录
# config.yaml 中配置(声明式单一入口)。本文件只放 config.yaml 用 ${ENV} 引用的
# 密钥与地址, 以及 start.sh 使用的端口/主机。
# =============================================================================

# 服务监听端口(start.sh 使用,默认 8443)。
PORT=8443

# 对外展示用的主机地址(start.sh 使用)。留空则自动探测本机 IP。
HOST_IP=

# 既有文本清洗 LLM(DashScope 兼容接口)的 API Key。
# 对应 config.yaml -> upstreams.dashscope_cleanup.api_key: ${DASHSCOPE_API_KEY}
DASHSCOPE_API_KEY=

# 增强语音识别专用 refine LLM(火山方舟 OpenAI 兼容接口)的 API Key。
# 对应 config.yaml -> upstreams.volcano_cleanup.api_key: ${ARK_APIKEY}
ARK_APIKEY=

# 热词抽取 LLM(取代旧 backend/api.json)。
# 对应 config.yaml -> upstreams.hotword_llm。base_url 为服务根(不含 /v1)。
HOTWORD_BASE_URL=
HOTWORD_MODEL=
HOTWORD_API_KEY=

# Triton 热词召回服务地址在 config.yaml -> upstreams.triton_recall 配置。
# 默认 http://localhost:10001 / rag_asr_retrieve, 不需要在 .env 中填写。

# k2 流式 ASR 服务地址与噪声门控在 config.yaml -> defaults.k2 配置。
# 默认 localhost:50051, 并启用 k2_voice_gate_* 抑制环境音误触发。
# 不需要在 .env 中填写。

# AST v3 角色分离的主服务开关、sidecar 地址和超时在
# config.yaml -> defaults.diarization 配置。NeMo sidecar 使用独立依赖环境，
# 生产部署默认启用 diarization_enabled；客户端不能覆写该资源开关。
# 模型路径、CUDA 设备和单卡动态 batch 由 deploy/audiollm-diarization.service 的
# DIARIZATION_MODEL_PATH / SPEAKER_EMBEDDING_MODEL_PATH / DIARIZATION_DEVICE /
# DIARIZATION_MAX_BATCH_SIZE / DIARIZATION_BATCH_WAIT_MS 设置，不加入本服务 .env。

# ASR final 前内部长静音删除阈值在
# config.yaml -> defaults.asr.asr_silence_removal_threshold_sec 配置。
# 0 表示关闭；大于 0 时会删除连续时长大于等于该秒数、且前后都有人声的内部静音。
# AudioLLM 前强制人声门控、过滤及首尾上下文由同组 asr_segment_voice_gate_* /
# asr_segment_voice_filter_* 服务端字段分别控制，客户端不可覆写。
# 不需要在 .env 中填写。
